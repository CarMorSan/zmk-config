            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_3>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_3>;

            label = "CIERRA_CORCHETES";
        };

        abre_llaves: abre_llaves {
