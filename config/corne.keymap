        comilla_simple: comilla_simple {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_9>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_9>;

            label = "COMILLA_SIMPLE";
        };

        comilla_invertida: comilla_invertida {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_6>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_6>;

            label = "COMILLA_INVERTIDA";
        };

        punto_y_coma: punto_y_coma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_5 &kp KP_NUMBER_9>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_5 &kp KP_NUMBER_9>;

            label = "PUNTO_Y_COMA";
        };

        dos_puntos: dos_puntos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_5 &kp KP_NUMBER_8>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_5 &kp KP_NUMBER_8>;

            label = "DOS_PUNTOS";
        };

        signo_admiracion: signo_admiracion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_3>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_3>;

            label = "SIGNO_ADMIRACION";
        };

        signo_mas: signo_mas {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3>;

            label = "SIGNO_MAS";
        };

        asterisco: asterisco {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_2>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_2>;

            label = "ASTERISCO";
        };

        signo_menos: signo_menos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_5>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_5>;

            label = "SIGNO_MENOS";
        };

        igual_que: igual_que {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_6 &kp KP_NUMBER_1>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_6 &kp KP_NUMBER_1>;

            label = "IGUAL_QUE";
        };

        signo_pesos: signo_pesos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_6>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_6>;

            label = "SIGNO_PESOS";
        };

        numeral: numeral {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_5>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_5>;

            label = "NUMERAL";
        };

        barra_vertical: barra_vertical {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_4>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_4>;

            label = "BARRA_VERTICAL";
        };

        guion_bajo: guion_bajo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_5>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_5>;

            label = "GUION_BAJO";
        };

        arroba: arroba {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_6 &kp KP_NUMBER_4>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_6 &kp KP_NUMBER_4>;

            label = "ARROBA";
        };

        ampersand: ampersand {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_8>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_8>;

            label = "AMPERSAND";
        };

        pico: pico {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_4>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_4>;

            label = "PICO";
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_6>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_6>;

            label = "TILDE";
        };

        por_ciento: por_ciento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_7>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_7>;

            label = "POR_CIENTO";
        };

        barra_invertida: barra_invertida {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_2>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_2>;

            label = "BARRA_INVERTIDA";
        };

        barra_inclinada: barra_inclinada {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_7>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_7>;

            label = "BARRA_INCLINADA";
        };

        enie: enie {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_4>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_4>;

            label = "ENIE";
        };

        abre_signo_exclamacion: abre_signo_exclamacion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_7 &kp KP_NUMBER_3>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_7 &kp KP_NUMBER_3>;

            label = "ABRE_SIGNO_EXCLAMACION";
        };

        a_acento: a_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_N6 &kp KP_N0>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_N6 &kp KP_N0>;

            label = "A_ACENTO";
        };

        e_acento: e_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_3 &kp KP_NUMBER_0>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_3 &kp KP_NUMBER_0>;

            label = "E_ACENTO";
        };

        i_acento: i_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_1>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_1>;

            label = "I_ACENTO";
        };

        o_acento: o_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_2>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_2>;

            label = "O_ACENTO";
        };

        u_acento: u_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_3>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_3>;

            label = "U_ACENTO";
        };

        A_acento: A_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_N8 &kp KP_N1>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_N8 &kp KP_N1>;

            label = "A_ACENTO";
        };

        E_acento: E_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_N4 &kp KP_N4>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_1 &kp KP_N4 &kp KP_N4>;

            label = "E_ACENTO";
        };

        I_acento: I_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_N2 &kp KP_N1 &kp KP_N4>,
                <&macro_release &kp LEFT_ALT &kp KP_N2 &kp KP_N1 &kp KP_N4>;

            label = "I_ACENTO";
        };

        O_acento: O_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_N2 &kp KP_N2 &kp KP_N4>,
                <&macro_release &kp LEFT_ALT &kp KP_N2 &kp KP_N2 &kp KP_N4>;

            label = "O_ACENTO";
        };

        U_acento: U_acento {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_N2 &kp KP_N3 &kp KP_N3>,
                <&macro_release &kp LEFT_ALT &kp KP_N2 &kp KP_N3 &kp KP_N3>;

            label = "U_ACENTO";
        };
    };

    combos {
        compatible = "zmk,combos";

        a_acento {
            bindings = <&a_acento>;
            key-positions = <19 13>;
        };

        e_acento {
            bindings = <&e_acento>;
            key-positions = <19 3>;
        };

        i_acento {
            bindings = <&i_acento>;
            key-positions = <16 8>;
        };

        o_acento {
            bindings = <&o_acento>;
            key-positions = <16 9>;
        };

        u_acento {
            bindings = <&u_acento>;
            key-positions = <16 7>;
        };

        A_acento {
            bindings = <&A_acento>;
            key-positions = <12 13>;
        };

        E_acento {
            bindings = <&E_acento>;
            key-positions = <12 3>;
        };

        I_acento {
            bindings = <&I_acento>;
            key-positions = <12 8>;
        };

        O_acento {
            bindings = <&O_acento>;
            key-positions = <12 9>;
        };

        U_acento {
            bindings = <&U_acento>;
            key-positions = <12 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        principal {
            bindings = <
&kp TAB       &kp Q  &kp W             &kp E                  &kp R          &kp T          &kp Y        &kp U                   &kp I         &kp O                &kp P      &kp BACKSPACE
&kp CAPSLOCK  &kp A  &kp S             &kp D                  &lt 4 F        &kp G          &kp H        &lt 5 J                 &kp K         &kp L                &kp SEMI   &kp ENTER
&kp LSHFT     &kp Z  &mt LEFT_SHIFT X  &kp C                  &kp V          &kp B          &kp N        &kp M                   &kp COMMA     &mt RIGHT_SHIFT DOT  &kp SLASH  &kp RSHFT
                                       &mt LGUI LEFT_BRACKET  &mt LCTRL TAB  &lt 1 SPACE    &lt 2 ENTER  &mt LEFT_ALT BACKSPACE  &lt 3 DELETE
            >;
        };

        flechas_seleccion {
            bindings = <
&kp ESC  &trans        &kp LS(LC(LEFT))  &kp LS(UP_ARROW)  &kp LS(LC(RIGHT))  &trans         &trans    &kp LC(LEFT_ARROW)  &kp UP_ARROW  &kp LC(RIGHT)  &trans   &trans
&trans   &kp LS(HOME)  &kp LS(LEFT)      &kp LS(DOWN)      &kp LS(RIGHT)      &kp LS(END)    &kp HOME  &kp LEFT            &kp DOWN      &kp RIGHT      &kp END  &trans
&trans   &trans        &trans            &trans            &trans             &trans         &trans    &trans              &trans        &trans         &trans   &trans
                                         &trans            &trans             &trans         &trans    &trans              &trans
            >;
        };

        numeros {
            bindings = <
&none   &none      &kp KP_N7  &kp KP_N8     &kp KP_N9  &none        &none         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none         &none
&none   &kp KP_N0  &kp KP_N4  &kp KP_N5     &kp KP_N6  &kp KP_N0    &kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0  &none
&trans  &none      &kp KP_N1  &kp KP_N2     &kp KP_N3  &none        &none         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none         &trans
                              &kp LEFT_GUI  &kp LCTRL  &none        &none         &kp LEFT_ALT  &kp DELETE
            >;
        };

        teclas_funcion_audio_capturas {
            bindings = <
&kp F1             &kp F2               &kp F3                       &kp F4         &kp F5      &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp C_VOLUME_UP    &kp LG(PRINTSCREEN)  &kp LC(LA(LG(PRINTSCREEN)))  &kp LG(LS(S))  &kp ESCAPE  &trans    &trans  &trans  &trans  &trans   &trans   &trans
&kp C_VOLUME_DOWN  &kp K_MUTE           &trans                       &trans         &trans      &trans    &trans  &trans  &trans  &trans   &trans   &trans
                                                                     &trans         &trans      &trans    &trans  &trans  &trans
            >;
        };

        signos_programacion_derecha {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &signo_admiracion  &signo_menos  &guion_bajo      &arroba      &tilde            &por_ciento
&trans  &trans  &trans  &trans  &trans  &trans    &signo_mas         &igual_que    &barra_vertical  &ampersand   &enie             &none
&trans  &trans  &trans  &trans  &trans  &trans    &asterisco         &numeral      &punto_y_coma    &dos_puntos  &barra_inclinada  &barra_invertida
                        &trans  &trans  &trans    &trans             &trans        &trans
            >;
        };

        signos_programacion_izquierda {
            bindings = <
&cierra_signo_interrogacion  &mayor_que  &cierra_corchetes  &cierra_llaves    &cierra_parentesis  &none                 &trans  &trans  &trans  &trans  &trans  &trans
&abre_signo_interrogacion    &menor_que  &abre_corchetes    &abre_llaves      &abre_parentesis    &none                 &trans  &trans  &trans  &trans  &trans  &trans
&abre_signo_exclamacion      &pico       &signo_pesos       &comillas_dobles  &comilla_simple     &comilla_invertida    &trans  &trans  &trans  &trans  &trans  &trans
                                                            &trans            &trans              &trans                &trans  &trans  &trans
            >;
        };
    };
};
