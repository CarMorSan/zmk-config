            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_4>,
                <&macro_release &kp LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_4>;

            label = "COMILLAS_DOBLES";
